# RecLens / BidForge AI Environment Configuration

# Provider selection: 'nvidia', 'gemini', or 'openai' (optional, fallback deterministic parser is active if not set)
LLM_PROVIDER=nvidia

# NVIDIA AI API (Recommended - NIM Endpoints)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Google Gemini API Key (Alternative)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Key (Alternative)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# API Server URL
NEXT_PUBLIC_API_URL=http://localhost:8000
